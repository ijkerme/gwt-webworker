<module>
  <!--
    GWT 2.13 descriptors are DTD-free.

    The previous revision of this file carried
      <!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.8.2//EN"
       "http://gwtproject.org/doctype/2.8.2/gwt-module.dtd">
    which pinned the descriptor to the 2017 schema. Every descriptor shipped by GWT 2.13.1
    (com/google/gwt/core/Core.gwt.xml, com/google/gwt/useragent/UserAgent.gwt.xml, ...) starts
    straight at <module> with no DOCTYPE, and the versioned gwt-module.dtd is no longer
    published or fetched. The DOCTYPE was therefore removed rather than bumped to 2.13.1.

    Side effect worth knowing: dropping the DOCTYPE also drops the "no DTD fetch over the
    network at compile time" failure mode that used to appear on offline/proxied builds.
  -->
  <inherits name="com.google.gwt.core.Core" />

  <!--
    Defines the `user.agent` deferred-binding property and the `user.agent.runtimeWarning`
    configuration property.

    Without this, the integration snippet the README documents for hosts -

      <inherits name="org.eostep.gwt.webworker.WebWorker" />
      <set-property name="user.agent" value="safari" />
      <set-configuration-property name="user.agent.runtimeWarning" value="false" />

    - fails at compile time with "Property 'user.agent' not found", because
    com.google.gwt.core.Core does not define `user.agent`; it only comes in through
    com.google.gwt.user.User (or this module) in a normal application. A worker module that
    inherits nothing else therefore had no way to pin a single permutation.

    com.google.gwt.useragent.UserAgent is the current module for this - the older
    com.google.gwt.user.UserAgent is only a deprecated alias and says so in its own header.
    As of GWT 2.13.1 the property has exactly two values, `gecko1_8` and `safari`; IE support
    was dropped in GWT 2.10.0.
  -->
  <inherits name="com.google.gwt.useragent.UserAgent" />

  <!--
    Elemental2 core, for `elemental2.core.JsArray<T>` and `elemental2.core.Transferable`.

    Both appear in this library's public API: the postMessage family takes a transfer list, and
    MessageEvent.getPorts() returns one. GWT's own JsArray cannot be used for that - it is
    declared `JsArray<T extends JavaScriptObject>`, and JavaScriptObject subclasses are exactly
    what a JsInterop native type (MessagePort, since 3.0.0) may not be. elemental2's JsArray has
    no bound on T, which is what makes the JsInterop rewrite of MessagePort possible at all.

    Inheriting this module also pulls in `jsinterop.base.Base` (elemental2.core.Core inherits it)
    and `elemental2.promise.Promise`. Consumers get all three transitively through Maven, so no
    extra action is needed on their side beyond the ordinary
    `<inherits name="org.eostep.gwt.webworker.WebWorker" />`.
  -->
  <inherits name="elemental2.core.Core" />

  <define-linker name="dedicatedworker"
    class="org.eostep.gwt.webworker.linker.DedicatedWorkerLinker" />
  <!-- Specify the app entry point class, in this case a dummy class. -->
  <entry-point class="org.eostep.gwt.webworker.client.GwtWebWorker" />
</module>

<module rename-to="demoworker">
  <!--
    This is the module that runs INSIDE the worker thread. Three things are load-bearing:

    1. `user.agent` must be pinned to a single value. A worker cannot inspect `navigator` the way a
       window can, so a multi-permutation module would fail at the browser's runtime property
       selection. `safari` is the current value that covers Chromium/WebKit; the only other value
       in GWT 2.13.1 is `gecko1_8`.
    2. `user.agent.runtimeWarning` must be off, otherwise the runtime property provider that is
       still emitted tries to warn about an undetectable agent.
    3. `add-linker name="dedicatedworker"` swaps the normal `xsiframe` linker for this library's
       `DedicatedWorkerLinker`, which emits a bootstrap that works with no `window` / `document`.
  -->
  <inherits name="org.eostep.gwt.webworker.WebWorker" />

  <set-property name="user.agent" value="safari" />
  <set-configuration-property name="user.agent.runtimeWarning" value="false" />

  <add-linker name="dedicatedworker" />

  <!-- The default source path is `client`, but this class sits in `...demo.worker`. -->
  <source path="" />

  <!--
    Declared explicitly. GWT does not infer the entry point from the module's short name: without
    this (and without a class literally called `EntryPoint` in the module's package) the module
    still compiles and links, and emits a bootstrap that never runs a single line of your code.
  -->
  <entry-point class="org.eostep.gwt.webworker.demo.worker.DemoWorker" />
</module>
